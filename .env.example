# ---- Django ----
DJANGO_SECRET_KEY=cambia-esto-en-produccion
DJANGO_DEBUG=True
# 'backend' es el nombre del servicio en Docker: el proxy de Vite reenvia con ese Host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_TIME_ZONE=America/Mexico_City

# ---- Base de datos ----
# En Docker Compose el host es el nombre del servicio: db
DATABASE_URL=postgres://focos:focos@db:5432/focos_rojos
POSTGRES_USER=focos
POSTGRES_PASSWORD=focos
POSTGRES_DB=focos_rojos

# ---- Cloudflare R2 ----
# El token NO debe tener permiso de borrado (las versiones son inmutables)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=focos-rojos
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# ---- Frontend ----
VITE_API_URL=http://localhost:8001/api
